" .ideavimrc is a configuration file for IdeaVim plugin. It uses
"   the same commands as the original .vimrc configuration.
" You can find a list of commands here: https://jb.gg/h38q75
" Find more examples here: https://jb.gg/share-ideavimrc


"" -- Suggested options --
" Show a few lines of context around the cursor. Note that this makes the
" text scroll if you mouse-click near the start or end of the window.
set scrolloff=5

" Do incremental searching.
set incsearch

" Don't use Ex mode, use Q for formatting.
map Q gq

" --- Enable IdeaVim plugins https://jb.gg/ideavim-plugins

"" -- Map IDE actions to IdeaVim -- https://jb.gg/abva4t
"" Map \r to the Reformat Code action
"map \r <Action>(ReformatCode)

"" Map <leader>d to start debug
"map <leader>d <Action>(Debug)

"" Map \b to toggle the breakpoint on the current line
"map \b <Action>(ToggleLineBreakpoint)

set commentary
set functiontextobj
set highlightedyank
set which-key
set rnu

" set <leader> to <space>
let mapleader = " "

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" NEO Test
if &ide =~? 'rider'
  " Run File 
  " Don't support

  " Run all test
  map <leader>tT <Action>(RiderUnitTestRunSolutionAction)

  " Run Nearest 
  map <leader>tr <Action>(RiderUnitTestRunContextAction)

  " Rerun the last test
  map <leader>tl <Action>(RerunTests)
  
  " Toggle Summary
  map <leader>ts <Action>(RiderUnitTestFocusExplorerAction)

  " Show output
  map <leader>to <Action>(RiderUnitTestSessionAbortAction)
  
  " Toggle output panel
  " Don't support

  " Stop
  map <leader>tS <Action>(RiderUnitTestSessionAbortAction)

  " Toggle watch 
  " Don't support
endif

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" LSP
map gd <Action>(GotoDeclaration) 
map gr <Action>(FindUsages)
map gi <Action>(ReSharperGotoImplementation)
map gy <Action>(GotoTypeDeclaration)
map gk <Action>(SmartTypeCompletion)

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" Code 
map <leader>ca <Action>(ShowIntentionActions)
map <leader>rR <Action>(RenameElement)
map <leader>cr <Action>(RenameElement)
map <leader>cf <Action>(ReformatCode)
map ]] <Action>(NextOccurence)
map [[ <Action>(PreviousOccurence)
map <leader>ud <Action>(ActivateProblemsViewToolWindow)
map <leader>ss <Action>(GotoSymbol)
map ]e <Action>(GotoNextError)
map [e <Action>(GotoPreviousError)
map <leader>db <Action>(ToggleLineBreakpoint)

" Git
map <leader>gb <Action>(Annotate)
map <leader>gd <Action>(ActivateCommitToolWindow)

" Move
map <leader>fb <Action>(Switcher)
map <leader>ff <Action>(GotoFile)
map <leader>fr <Action>(RecentLocations)
map <leader>sg <Action>(SearchEverywhere)
